---
import '@fontsource/be-vietnam-pro/400.css';
import '@fontsource/be-vietnam-pro/600.css';
import '../styles/global.css';
import TabBar, { type TabId } from '../components/TabBar.astro';
import UpdateBanner from '../components/UpdateBanner.astro';
import { url } from '../lib/url';

interface Props {
  title: string;
  tab?: TabId;
  /** mô tả trang (thẻ meta, xem trước khi chia sẻ link) */
  description?: string;
  /** Màn hình tập trung (một lượt gõ): không có thanh tab, không hiện thông báo cập nhật app. */
  focus?: boolean;
}
const DESC = 'Đọc, viết, gõ chữ Hán cho người Việt: pinyin theo ngữ cảnh, màu thanh điệu, âm Hán Việt, nét chữ. Miễn phí, chạy offline.';
const { title, tab, description = DESC, focus = false } = Astro.props;
const fullTitle = tab === 'doc' ? 'Chữ Hán · Đọc, viết, gõ chữ Hán cho người Việt' : `${title} · Chữ Hán`;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const swEnabled = import.meta.env.PUBLIC_SW !== 'off';
const swUrl = url('sw.js');
const scope = url();
---

<!doctype html>
<html lang="vi">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Chữ Hán" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(url('icons/icon-512.png'), Astro.site).href} />
    <meta property="og:locale" content="vi_VN" />
    <meta name="theme-color" content="#fcfcfb" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#1a1a19" media="(prefers-color-scheme: dark)" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="Chữ Hán" />
    <link rel="manifest" href={url('manifest.webmanifest')} />
    <link rel="icon" href={url('icons/favicon.svg')} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={url('icons/apple-touch-icon.png')} />
    <title>{title} · Chữ Hán</title>
  </head>
  <body class="min-h-dvh bg-paper text-ink antialiased">
    {
      focus ? (
        <main class="mx-auto w-full max-w-2xl px-4 pt-3 pb-8" data-focus>
          <slot />
        </main>
      ) : (
        <div class="lg:flex">
          <TabBar active={tab} />
          <div class="min-w-0 lg:flex-1">
            <header class="mx-auto flex w-full max-w-2xl items-center justify-between px-4 pt-3 lg:hidden" data-print-hide>
              <a href={url()} class="inline-flex min-h-11 items-center gap-2">
                <span class="han text-xl font-semibold text-accent" lang="zh-CN">字</span>
                <span class="font-semibold">Chữ Hán</span>
              </a>
              <a
                href={url('tra/')}
                aria-label="Tra từ"
                class:list={['inline-flex size-11 items-center justify-center rounded-full hover:bg-accent-soft', tab === 'tra' ? 'text-accent' : 'text-muted']}
              >
                <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true">
                  <path d="M11 4a7 7 0 1 0 0 14 7 7 0 0 0 0-14zM20 20l-4-4" />
                </svg>
              </a>
            </header>
            <main class="mx-auto w-full max-w-2xl px-4 pt-3 lg:pt-6">
              <slot />
            </main>
            <footer class="mx-auto w-full max-w-2xl px-4 pb-28 lg:pb-12" data-print-hide>
              <nav aria-label="Liên hệ" class="mt-12 flex flex-wrap justify-center border-t border-line pt-3 text-xs text-muted">
                <a class="inline-flex min-h-11 items-center px-2 hover:text-ink hover:underline" href={url('gioi-thieu/#gop-y')}>Góp ý</a>
                <a class="inline-flex min-h-11 items-center px-2 hover:text-ink hover:underline" href={url('gioi-thieu/#ung-ho')}>Ủng hộ</a>
              </nav>
            </footer>
          </div>
        </div>
      )
    }
    {!focus && <UpdateBanner />}
    {
      swEnabled && (
        <script is:inline define:vars={{ swUrl, scope }}>
          if ('serviceWorker' in navigator) {
            window.addEventListener('load', function () {
              navigator.serviceWorker
                .register(swUrl, { scope: scope, updateViaCache: 'none' })
                .then(function (reg) {
                  window.__swReg = reg;
                  window.dispatchEvent(new CustomEvent('sw-registered', { detail: reg }));
                })
                .catch(function (err) {
                  console.warn('Không đăng ký được service worker', err);
                });
            });
          }
        </script>
      )
    }
  </body>
</html>
