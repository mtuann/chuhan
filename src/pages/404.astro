---
import Base from '../layouts/Base.astro';
import { url } from '../lib/url';
const base = import.meta.env.BASE_URL;
---

<Base title="Không tìm thấy trang">
  <script is:inline define:vars={{ base }}>
    // Chuyển /tu/<từ>/ → /tu/?w=<từ> và /chu/<chữ>/ → /chu/?c=<chữ> (xem src/lib/redirect.ts).
    (function () {
      var prefix = '/' + base.replace(/^\/+|\/+$/g, '') + '/';
      if (prefix === '//') prefix = '/';
      var path = location.pathname;
      if (path.indexOf(prefix) !== 0) return;
      var rest = path.slice(prefix.length).replace(/\/+$/, '');
      var m = /^(tu|chu)\/([^/]+)$/.exec(rest);
      if (!m) return;
      var value;
      try {
        value = decodeURIComponent(m[2]);
      } catch (e) {
        return;
      }
      if (!value) return;
      var key = m[1] === 'tu' ? 'w' : 'c';
      location.replace(prefix + m[1] + '/?' + key + '=' + encodeURIComponent(value));
    })();
  </script>
  <h1 class="text-2xl font-semibold">Không tìm thấy trang</h1>
  <p class="mt-3 text-muted">Trang này không có hoặc đã được chuyển.</p>
  <a href={url()} class="mt-6 inline-flex min-h-11 items-center rounded-lg bg-accent px-4 font-semibold text-accent-ink">
    Về trang Đọc
  </a>
</Base>
